# Copy to .env and adjust as needed. docker-compose reads this file automatically.

# --- Frontend -> API wiring ---
# Base URL the browser uses to reach the API. If you're opening the UI from
# another machine, set this to that machine's reachable address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- CORS (API side) ---
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_MB=2048
MIN_FREE_DISK_MB=2048

# --- Celery / Redis ---
CELERY_CONCURRENCY=2

# --- Transcription (faster-whisper) ---
# Model size: tiny, base, small, medium, large-v3. CPU-only by default.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional speaker diarization via WhisperX. Off by default — see README for
# the extra setup (torch, pyannote.audio, a HuggingFace token) this requires.
ENABLE_DIARIZATION=false
HF_TOKEN=

# --- Frame extraction ---
MAX_FRAMES=2000
DEFAULT_TARGET_FRAMES=80
ADAPTIVE_MIN_FRAMES=30
ADAPTIVE_MAX_FRAMES=150
FRAME_MAX_DIM_DEFAULT=1280
FRAME_JPEG_QUALITY=85

# --- Job lifecycle ---
RETENTION_HOURS=72
STALE_JOB_TIMEOUT_MINUTES=30
FFMPEG_TIMEOUT_SECONDS=3600
WHISPER_TIMEOUT_SECONDS=3600

# --- URL ingestion (yt-dlp) ---
# yt-dlp's version is pinned in requirements.txt for reproducible builds; it
# is never auto-updated on startup. It self-updates once, on-demand, only
# when an extraction fails in a way that looks like a broken/outdated
# extractor rather than a genuinely unavailable video.
YTDLP_COMMENT_LIMIT=100
# Path to a cookies.txt (exported from your browser) for account-gated
# fetches, mainly Instagram. Optional — leave blank if you don't need it.
COOKIES_FILE=

APP_VERSION=0.1.0
