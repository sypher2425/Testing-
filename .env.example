# Copy to .env and adjust as needed. docker-compose reads this file automatically.

# --- Frontend -> API wiring ---
# Leave blank to use the built-in same-origin proxy (recommended). This keeps
# uploads working whether the site is opened via localhost, 127.0.0.1, or a
# LAN hostname. Set a full URL only when the API is intentionally external.
NEXT_PUBLIC_API_BASE_URL=
# Client-side upload cap, mirrored from MAX_UPLOAD_MB below so the browser
# rejects an oversized file before transferring it. Keep the two in sync.
NEXT_PUBLIC_MAX_UPLOAD_MB=61440

# --- CORS (API side) ---
# Comma-separated. Both loopback spellings are listed because a browser treats
# localhost and 127.0.0.1 as different origins — listing only one makes the UI
# fail with an opaque "Failed to fetch" depending on what you typed. Add your
# machine's LAN address here to use the UI from another device.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Raw file uploads stream directly to port 8000. This default regex permits
# browser origins on localhost and private LAN addresses while rejecting
# arbitrary public origins. Override only for a different trusted deployment.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\]|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?::\d+)?$

# --- Uploads ---
# 60GB. Large files use the streaming endpoint (POST /api/jobs/upload) which
# writes the raw body straight to disk; oversized uploads are rejected with a
# 413 from Content-Length before any bytes transfer.
MAX_UPLOAD_MB=61440
# Free-space safety margin never consumed by an upload.
MIN_FREE_DISK_MB=2048
# Disk required = upload size x this + the margin above. A source video costs
# more than its own size: extracted frames, the temp audio.wav, and output.zip
# all land on the same volume. A 60GB upload therefore needs ~92GB free.
UPLOAD_DISK_HEADROOM_MULTIPLIER=1.5
# Streaming write size (8MiB).
UPLOAD_CHUNK_BYTES=8388608
# ffprobe validation of the uploaded file, before the job is queued.
FFPROBE_TIMEOUT_SECONDS=120

# --- Celery / Redis ---
# Transcription loads a ~460MB-1GB Whisper model per concurrent worker child.
# Two at once on a memory-capped Docker Desktop can be OOM-killed, which looks
# exactly like a job stuck forever — so this defaults to 1 and jobs queue.
# Raise it only if you have RAM headroom. (CELERY_CONCURRENCY still works as
# an alias for this setting.)
TRANSCRIPTION_CONCURRENCY=1
# Worker children are recycled after this many tasks (0 = never). A recycled
# child reloads the model from the on-disk cache — fast, and never re-downloads.
WORKER_MAX_TASKS_PER_CHILD=100

# --- Transcription (faster-whisper) ---
# Model size: tiny, base, small, medium, large-v3. CPU-only by default.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional speaker diarization via WhisperX. Off by default — see README for
# the extra setup (torch, pyannote.audio, a HuggingFace token) this requires.
ENABLE_DIARIZATION=false
HF_TOKEN=
# Model weights are cached here. docker-compose mounts this path as the
# `whisper_cache` named volume, so `up --build` never re-downloads the model
# (only `down -v` clears it).
HF_HOME=/root/.cache/huggingface
# Bounds a single download socket read — without it a stalled connection
# hangs with no output.
HF_HUB_DOWNLOAD_TIMEOUT=60
# Load the model when the worker boots so a slow first download shows up in
# the worker log immediately instead of looking like a stuck job.
WARM_MODEL_ON_STARTUP=true

# --- Frame extraction ---
MAX_FRAMES=2000
DEFAULT_TARGET_FRAMES=80
ADAPTIVE_MIN_FRAMES=30
ADAPTIVE_MAX_FRAMES=150
FRAME_MAX_DIM_DEFAULT=1280
FRAME_JPEG_QUALITY=85

# --- Job lifecycle ---
RETENTION_HOURS=72
# Applies to RUNNING jobs only: no heartbeat for this long means the worker died.
STALE_JOB_TIMEOUT_MINUTES=30
# Applies to jobs still WAITING in the queue. Much longer, because with
# concurrency 1 a huge source can legitimately hold the queue for hours — but a
# job whose enqueue never reached the broker still fails eventually.
QUEUED_JOB_TIMEOUT_HOURS=24
# 6h per step: decoding a very large video is hours of work, not minutes.
FFMPEG_TIMEOUT_SECONDS=21600
# Bounds the transcription loop itself.
WHISPER_TIMEOUT_SECONDS=21600
# Bounds model load + the first-run download separately: a slow 460MB
# download is a different failure from a wedged transcription.
WHISPER_MODEL_LOAD_TIMEOUT_SECONDS=1800
# How often last_heartbeat is refreshed during long blocking calls, so the
# stale-job reaper can tell "slow" from "dead".
HEARTBEAT_INTERVAL_SECONDS=10
# Celery's own backstop above the per-step limits (soft raises in-task, hard
# kills the child). 24h accommodates a 60GB source; the heartbeat reaper is
# what actually catches a wedged job.
TASK_SOFT_TIME_LIMIT_SECONDS=86400
TASK_HARD_TIME_LIMIT_SECONDS=86700
# Jobs found mid-flight after a worker restart: "requeue" (re-run from the
# top if the source still exists) or "fail".
STARTUP_RECOVERY_MODE=requeue

# --- URL ingestion (yt-dlp) ---
# yt-dlp's version is pinned in requirements.txt for reproducible builds.
# It is never updated during a job -- see YTDLP_CHANNEL below.
#
# Some extractors ask to impersonate a real browser's TLS fingerprint, which
# needs curl_cffi — hence the `yt-dlp[default,curl-cffi]` pin in
# requirements.txt. Check inside the worker with:
#   docker compose exec worker yt-dlp --list-impersonate-targets
YTDLP_COMMENT_LIMIT=100
# TikTok has two extraction paths: the web page, and the mobile API. yt-dlp
# only attempts the API when it has app info — so without this set it goes
# straight to the web page, which TikTok increasingly answers with a
# bot-check ("Unable to extract universal data for rehydration"). That error
# tells you to update yt-dlp; updating does not fix it.
# To get your device ID: TikTok app -> Settings -> scroll to the bottom ->
# tap the version number 5 times.
TIKTOK_DEVICE_ID=
# Raw yt-dlp --extractor-args passthrough, semicolon-separated. For anything
# the settings above don't cover, e.g.
#   YTDLP_EXTRACTOR_ARGS=tiktok:app_info=1234567890;youtube:player_client=web
YTDLP_EXTRACTOR_ARGS=

# Release channel, applied at worker startup -- never during a job. Swapping
# the binary under running work changed the tool mid-flight and never fixed
# the failure that triggered it. "stable" or "nightly".
YTDLP_CHANNEL=stable
YTDLP_UPDATE_ON_STARTUP=false
# TLS fingerprint forced on every request, when curl_cffi makes it available.
YTDLP_IMPERSONATE_TARGET=chrome
# Pause before the single anonymous retry, so a challenge page doesn't
# immediately earn a rate limit.
YTDLP_RETRY_DELAY_SECONDS=2.0
# Route yt-dlp through a proxy: "http://user:pass@host:port" or
# "socks5://host:1080". This is the only real answer when a platform blocks
# the server's IP outright -- TikTok blocks whole datacenter ranges, and no
# amount of retrying from the same address helps. Residential proxies work;
# another datacenter usually does not. Credentials here are redacted from
# logs and the diagnostics endpoint.
YTDLP_PROXY=
# Path to a cookies.txt (exported from your browser) for account-gated
# fetches, mainly Instagram view counts. Optional — leave blank (the
# default) if you don't need it. To enable: drop the file at
# secrets/cookies.txt (bind-mounted into the worker container) and
# uncomment the line below — see secrets/README.md for the full walkthrough.
COOKIES_FILE=
# COOKIES_FILE=/run/secrets/cookies.txt

# Maximum comments to collect per URL-ingested job (alias: MAX_COMMENTS).
# YTDLP_COMMENT_LIMIT=100

# --- Research mode (topic search -> transcript bundle) ---
# Subtitle languages to fetch, in yt-dlp --sub-langs syntax.
RESEARCH_SUB_LANGS=en.*

# --- Dataset schema v2: dense opening frames ---
# Extract a frame every OPENING_DENSE_INTERVAL seconds during the first
# OPENING_DENSE_DURATION seconds (hook analysis). Overridable per job.
OPENING_DENSE_DURATION=8
OPENING_DENSE_INTERVAL=0.25

# --- Storyboards ---
# Contact sheets that let an AI read the visual timeline without opening every
# frame. Sized as an INDEX, not a detail view: vision models downscale a 2400px
# sheet to ~1568px, so a sheet packed with tiles becomes unreadable. Every tile
# links back to its full-resolution frame in storyboard_manifest.json.
STORYBOARD_ENABLED=true
STORYBOARD_SHEET_WIDTH_PX=2400
# Keeps a portrait grid (tall tiles) from becoming an unreadable ribbon.
STORYBOARD_MAX_SHEET_HEIGHT_PX=4200
STORYBOARD_MAX_TILES_PER_SHEET=24
# Portrait video gets fewer columns than landscape: the tiles are taller, so the
# same column count would double the sheet height.
STORYBOARD_COLUMNS_PORTRAIT=5
STORYBOARD_COLUMNS_LANDSCAPE=6
STORYBOARD_JPEG_QUALITY=90
STORYBOARD_INCLUDE_CAPTIONS=true
STORYBOARD_THEME=dark
# Uniform-timeline sheet spacing; widened automatically when the extracted
# frames are sparser than this.
STORYBOARD_TIMELINE_INTERVAL_SECONDS=1.0
STORYBOARD_KEY_MOMENTS_MAX=24

# --- ZIP output ---
# The source video is excluded from output.zip by default: the archive carries
# the analysis (transcripts, frames, metadata) while the video stays on disk and
# downloadable from /api/jobs/{id}/video. Zipping tens of GB of already-
# compressed H.264 costs hours of CPU for ~0% saving plus a second full copy.
ZIP_INCLUDE_SOURCE_VIDEO=false

APP_VERSION=0.1.0
